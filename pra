#include<iostream>

using namespace std;
struct hello{
    float a,b;
    void input(){
        cout<<"enter the value of first operator"<<endl;
        cin>>a;
        cout<<"enter the value of second operator"<<endl;
        cin>>b;
    }
    void addition(){
        cout<<a+b<<endl;
    }
    void substraction(){
        cout<<a-b<<endl;
    }

};
int main(){
    int choice;
    hello s1;
    s1.input();
    cout<<"enter your choice"<<endl;
    cin>>choice;
    switch(choice){
        case 1: cout<<"substration"<<endl;
              s1.substraction();
              break;
        case 2:cout<<"addition"<<endl;
               s1.addition();
               break;
        default:
        cout<<"invalid choice"<<endl;
    }
}